# Development image only: Node + Shopify CLI. Source and node_modules are mounted by compose.yaml.
# Production uses ./Dockerfile.
FROM node:22-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates git \
  && rm -rf /var/lib/apt/lists/*

# Global npm packages go in the node user's home so the CLI's Cloudflare tunnel plugin can
# download its binary without root.
USER node
ENV NPM_CONFIG_PREFIX=/home/node/.npm-global
ENV PATH=/home/node/.npm-global/bin:$PATH
RUN npm install -g @shopify/cli@4.9.4 && npm cache clean --force

# Created here so the mounted volumes are owned by node, not root.
RUN mkdir -p /home/node/.config /home/node/.cache /home/node/app/node_modules
WORKDIR /home/node/app

COPY --chown=node:node docker/dev-entrypoint.sh /usr/local/bin/dev-entrypoint.sh
ENTRYPOINT ["/usr/local/bin/dev-entrypoint.sh"]
CMD ["npm", "run", "dev"]
