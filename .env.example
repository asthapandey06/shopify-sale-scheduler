# Copy to .env for local development. Never commit real values.

# Filled in by `shopify app dev` locally; set these yourself in production.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://your-app.example.com
SCOPES=write_products

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pricetide

# Encrypts Shopify tokens at rest. Generate a key with:
#   node -e "console.log('k1:' + require('crypto').randomBytes(32).toString('base64'))"
# To rotate: put the new key first and keep the old one after it, e.g. k2:NEW,k1:OLD
TOKEN_ENCRYPTION_KEYS=

# Shown on the public privacy policy page (/privacy). Required in production.
SUPPORT_EMAIL=
APP_OWNER_NAME=

# Billing
PLAN_PRICE=9.99
TRIAL_DAYS=7
# Defaults to true outside production. Development stores always use test charges.
BILLING_TEST_MODE=

# Background scheduler (runs inside the web process)
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=30

# Optional: enables POST /jobs/tick for external cron (min 32 chars).
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Limits
MAX_VARIANTS_PER_SALE=5000
MAX_LIVE_SALES_PER_SHOP=20

LOG_LEVEL=info

# Docker development database (compose.yaml). Used only when ~/.pricetide-dev/pgdata is first created.
# Use letters and digits only in the password, since it is placed in DATABASE_URL.
POSTGRES_USER=pricetide
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pricetide
# With Docker: DATABASE_URL=postgresql://pricetide:<POSTGRES_PASSWORD>@db:5432/pricetide
